generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "game"]
}

model User {
  id           BigInt     @id @default(autoincrement())
  user_name    String     @unique @db.VarChar(50)
  password     String     @db.VarChar(36)
  email        String     @unique @db.VarChar(255)
  display_name String
  gender       Boolean
  avatar_seq   Int        @default(0)
  is_bot       Boolean    @default(false)
  room_users   RoomUser[]
  won_games    Game[]     @relation("Game_winner")

  @@map("users")
  @@schema("auth")
}

model Room {
  id         BigInt     @id @default(autoincrement())
  name       String
  status     Int        @db.SmallInt
  red_first  Boolean    @default(true)
  pve_mode   Boolean    @default(false)
  bet_amount Int        @default(10)
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  updated_at DateTime   @default(now()) @db.Timestamptz(6)
  is_active  Boolean    @default(true)
  room_users RoomUser[]
  games      Game[]

  @@map("rooms")
  @@schema("game")
}

model RoomUser {
  room_id   BigInt
  user_id   BigInt
  team      String?  @db.VarChar(10)
  joined_at DateTime @default(now()) @db.Timestamptz(6)
  rooms     Room     @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users     User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([room_id, user_id])
  @@map("room_users")
  @@schema("game")
}

model Game {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  room_id        BigInt   @db.BigInt
  winner_id      BigInt?  @db.BigInt
  status         Int      @db.SmallInt @default(0)
  bot_difficulty Int?     @db.SmallInt
  room           Room     @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  winner         User?    @relation("Game_winner", fields: [winner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("games")
  @@schema("game")
}
